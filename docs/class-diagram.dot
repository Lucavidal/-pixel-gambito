}
subgraph cluster_rules { label=<<B>rules</B>>; style="rounded,dashed"; color="#3b6fd8"; fontsize=12;
CheckDetector [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><B>CheckDetector</B></TD></TR><TR><TD> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+isInCheck(Board, Color): boolean<BR ALIGN="LEFT"/>+isAttacked(Board, Position, Color): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
MoveValidator [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><B>MoveValidator</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-checkDetector: CheckDetector<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+legalMoves(Board, Position): Set&lt;Position&gt;<BR ALIGN="LEFT"/>+isValidMove(Board, Position, Position): boolean<BR ALIGN="LEFT"/>+leavesKingInCheck(Board, Position, Position, Color): boolean<BR ALIGN="LEFT"/>+hasAnyLegalMove(Board, Color): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
