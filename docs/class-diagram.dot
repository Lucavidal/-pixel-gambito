digraph UML {
graph [rankdir=TB, fontname="Helvetica", nodesep=0.35, ranksep=0.55, newrank=true, pad=0.3, label=<<B>TPO Ajedrez — Diagrama de clases</B><BR/><FONT POINT-SIZE="10">Azul: núcleo · Amarillo: interfaces · Verde: adaptadores · Violeta: donde se inyectan las dependencias. Todas las flechas entre adaptadores y núcleo apuntan HACIA el núcleo.</FONT>>, labelloc=t, fontsize=16];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9];
subgraph cluster_core { label=<<B>NÚCLEO (ar.edu.uade.chess.core) — sin dependencias de frameworks ni UI</B>>; style="rounded"; color="#3b6fd8"; penwidth=2; fontsize=13;
subgraph cluster_auth { label=<<B>auth  (puerto de entrada IAuthService, puerto de salida IUserRepository)</B>>; style="rounded,dashed"; color="#3b6fd8"; fontsize=12;
IAuthService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6"><FONT POINT-SIZE="9">«interface»</FONT><BR/><I><B>IAuthService</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+register(String, String): AuthResult<BR ALIGN="LEFT"/>+login(String, String): Optional&lt;User&gt;<BR ALIGN="LEFT"/>+isRegistered(String): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
AuthService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><B>AuthService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+MIN_PASSWORD_LENGTH, MIN_/MAX_USERNAME_LENGTH: int<BR ALIGN="LEFT"/>-users: IUserRepository<BR ALIGN="LEFT"/>-hasher: IPasswordHasher<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+register(...): AuthResult<BR ALIGN="LEFT"/>+login(...): Optional&lt;User&gt;<BR ALIGN="LEFT"/>-normalize(String): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
AuthResult [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>AuthResult</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">SUCCESS, INVALID_USERNAME,<BR ALIGN="LEFT"/>PASSWORD_TOO_SHORT,<BR ALIGN="LEFT"/>USERNAME_TAKEN, UNKNOWN_USER,<BR ALIGN="LEFT"/>WRONG_PASSWORD<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getMessage(): String<BR ALIGN="LEFT"/>+isSuccess(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
User [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>User</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+username: String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
UserAccount [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>UserAccount</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+username: String<BR ALIGN="LEFT"/>+passwordHash: String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
IUserRepository [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6"><FONT POINT-SIZE="9">«interface»</FONT><BR/><I><B>IUserRepository</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">«puerto de salida»<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+findByUsername(String): Optional&lt;UserAccount&gt;<BR ALIGN="LEFT"/>+save(UserAccount)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
IPasswordHasher [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6"><FONT POINT-SIZE="9">«interface»</FONT><BR/><I><B>IPasswordHasher</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+hash(String): String<BR ALIGN="LEFT"/>+matches(String, String): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Pbkdf2PasswordHasher [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><B>Pbkdf2PasswordHasher</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+DEFAULT_ITERATIONS: int<BR ALIGN="LEFT"/>-iterations: int<BR ALIGN="LEFT"/>-random: SecureRandom<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+hash(String): String<BR ALIGN="LEFT"/>+matches(String, String): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_history { label=<<B>history  (Decorator, puerto de salida IMatchHistoryRepository)</B>>; style="rounded,dashed"; color="#3b6fd8"; fontsize=12;
RecordingTournament [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><FONT POINT-SIZE="9">«decorator»</FONT><BR/><B>RecordingTournament</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-tournament: ITournament<BR ALIGN="LEFT"/>-history: IMatchHistoryRepository<BR ALIGN="LEFT"/>-user: User<BR ALIGN="LEFT"/>-clock: Clock<BR ALIGN="LEFT"/>-userMovesThisRound: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+play(...), playUserMove(...),<BR ALIGN="LEFT"/>+playOpponentMove(): TurnReport<BR ALIGN="LEFT"/>-recording(Supplier&lt;TurnReport&gt;)<BR ALIGN="LEFT"/>+(el resto delega en tournament)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
IMatchHistoryRepository [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6"><FONT POINT-SIZE="9">«interface»</FONT><BR/><I><B>IMatchHistoryRepository</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">«puerto de salida»<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+save(RoundRecord)<BR ALIGN="LEFT"/>+findByUsername(String): List&lt;RoundRecord&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
RoundRecord [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>RoundRecord</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+username: String<BR ALIGN="LEFT"/>+rivalName: String<BR ALIGN="LEFT"/>+round: int<BR ALIGN="LEFT"/>+totalRounds: int<BR ALIGN="LEFT"/>+outcome: RoundOutcome<BR ALIGN="LEFT"/>+userMoves: int<BR ALIGN="LEFT"/>+playedAt: LocalDateTime<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+wonTheTournament(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
IHistoryService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6"><FONT POINT-SIZE="9">«interface»</FONT><BR/><I><B>IHistoryService</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+summary(User): HistorySummary<BR ALIGN="LEFT"/>+recentRounds(User, int): List&lt;RoundRecord&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
HistoryService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><B>HistoryService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-repository: IMatchHistoryRepository<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+summary(User): HistorySummary<BR ALIGN="LEFT"/>+recentRounds(User, int): List&lt;RoundRecord&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
HistorySummary [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>HistorySummary</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+roundsPlayed, wins, losses,<BR ALIGN="LEFT"/>+draws, titles: int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_tournament { label=<<B>tournament  (puerto ITournament, Factory)</B>>; style="rounded,dashed"; color="#3b6fd8"; fontsize=12;
ITournament [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6"><FONT POINT-SIZE="9">«interface»</FONT><BR/><I><B>ITournament</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+start()<BR ALIGN="LEFT"/>+getCurrentRound(): int<BR ALIGN="LEFT"/>+getTotalRounds(): int<BR ALIGN="LEFT"/>+getCurrentRival(): HistoricalPlayer<BR ALIGN="LEFT"/>+getRivals(): List&lt;HistoricalPlayer&gt;<BR ALIGN="LEFT"/>+play(Position, Position): TurnReport<BR ALIGN="LEFT"/>+playUserMove(Position, Position): TurnReport<BR ALIGN="LEFT"/>+playOpponentMove(): TurnReport<BR ALIGN="LEFT"/>+isAwaitingOpponent(): boolean<BR ALIGN="LEFT"/>+getBoard(): BoardView<BR ALIGN="LEFT"/>+getGameStatus(): GameStatus<BR ALIGN="LEFT"/>+getUserColor(): Color<BR ALIGN="LEFT"/>+legalMoves(Position): Set&lt;Position&gt;<BR ALIGN="LEFT"/>+getStatus(): TournamentStatus<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Tournament [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><B>Tournament</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-rivals: List&lt;HistoricalPlayer&gt;<BR ALIGN="LEFT"/>-gameFactory: IGameFactory<BR ALIGN="LEFT"/>-opponentFactory: IOpponentFactory<BR ALIGN="LEFT"/>-userColor: Color<BR ALIGN="LEFT"/>-roundIndex: int<BR ALIGN="LEFT"/>-game: IGame<BR ALIGN="LEFT"/>-opponent: IMoveChooser<BR ALIGN="LEFT"/>-status: TournamentStatus<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+start()<BR ALIGN="LEFT"/>+play(...)<BR ALIGN="LEFT"/>+playUserMove(...)<BR ALIGN="LEFT"/>+playOpponentMove()<BR ALIGN="LEFT"/>+isAwaitingOpponent()<BR ALIGN="LEFT"/>-startRound()<BR ALIGN="LEFT"/>-playOpponent(): Move<BR ALIGN="LEFT"/>-currentOutcome(): RoundOutcome<BR ALIGN="LEFT"/>-resolve(RoundOutcome)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
TournamentStatus [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>TournamentStatus</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">NOT_STARTED, IN_PROGRESS,<BR ALIGN="LEFT"/>ELIMINATED, CHAMPION<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getDisplayName(): String<BR ALIGN="LEFT"/>+isOver(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
RoundOutcome [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>RoundOutcome</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">ONGOING, WON, LOST, DRAWN<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+isFinished(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
TurnReport [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>TurnReport</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+userResult: MoveResult<BR ALIGN="LEFT"/>+aiReply: Move<BR ALIGN="LEFT"/>+outcome: RoundOutcome<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
HistoricalPlayer [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>HistoricalPlayer</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+name: String<BR ALIGN="LEFT"/>+description: String<BR ALIGN="LEFT"/>+style: IPlayStyle<BR ALIGN="LEFT"/>+difficulty: Difficulty<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
HistoricalPlayerFactory [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><FONT POINT-SIZE="9">«factory»</FONT><BR/><B>HistoricalPlayerFactory</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+DEFAULT_ROUNDS: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+createRoster(): List&lt;HistoricalPlayer&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
IGameFactory [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6"><FONT POINT-SIZE="9">«interface»</FONT><BR/><I><B>IGameFactory</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+create(): IGame<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
BoardSetupGameFactory [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><B>BoardSetupGameFactory</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-setup: IBoardSetup<BR ALIGN="LEFT"/>-validator: MoveValidator<BR ALIGN="LEFT"/>-checkDetector: CheckDetector<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+create(): IGame<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
IOpponentFactory [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6"><FONT POINT-SIZE="9">«interface»</FONT><BR/><I><B>IOpponentFactory</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+create(HistoricalPlayer): IMoveChooser<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_ai { label=<<B>ai  (Strategy: IPlayStyle)</B>>; style="rounded,dashed"; color="#3b6fd8"; fontsize=12;
Move [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>Move</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+from: Position<BR ALIGN="LEFT"/>+to: Position<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
IMoveChooser [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6"><FONT POINT-SIZE="9">«interface»</FONT><BR/><I><B>IMoveChooser</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+chooseMove(IGame): Move<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ComputerPlayer [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><B>ComputerPlayer</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-style: IPlayStyle<BR ALIGN="LEFT"/>-difficulty: Difficulty<BR ALIGN="LEFT"/>-analyzer: MoveAnalyzer<BR ALIGN="LEFT"/>-random: Random<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+chooseMove(IGame): Move<BR ALIGN="LEFT"/>-bestMove(IGame, List&lt;Move&gt;): Move<BR ALIGN="LEFT"/>-legalMoves(IGame): List&lt;Move&gt;<BR ALIGN="LEFT"/>+getStyle(): IPlayStyle<BR ALIGN="LEFT"/>+getDifficulty(): Difficulty<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
IPlayStyle [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6"><FONT POINT-SIZE="9">«interface»</FONT><BR/><I><B>IPlayStyle</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+CHECKMATE_BONUS: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+score(MoveFacts): int<BR ALIGN="LEFT"/>+getDisplayName(): String<BR ALIGN="LEFT"/>+getDescription(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
AggressiveStyle [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><B>AggressiveStyle</B></TD></TR><TR><TD> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+score(MoveFacts): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
DefensiveStyle [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><B>DefensiveStyle</B></TD></TR><TR><TD> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+score(MoveFacts): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
BalancedStyle [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><B>BalancedStyle</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-aggressive: IPlayStyle<BR ALIGN="LEFT"/>-defensive: IPlayStyle<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+score(MoveFacts): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Difficulty [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Difficulty</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">EASY, MEDIUM, HARD<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getDisplayName(): String<BR ALIGN="LEFT"/>+randomMoveProbability(): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
MoveAnalyzer [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><B>MoveAnalyzer</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-pieceValue: PieceValue<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+analyze(IGame, Move): MoveFacts<BR ALIGN="LEFT"/>~squaresOf(BoardView, Color): Set&lt;Position&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
MoveFacts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>MoveFacts</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+capturedValue: int<BR ALIGN="LEFT"/>+givesCheck: boolean<BR ALIGN="LEFT"/>+givesCheckmate: boolean<BR ALIGN="LEFT"/>+hangingValue: int<BR ALIGN="LEFT"/>+kingShelter: int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
PieceValue [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><B>PieceValue</B></TD></TR><TR><TD> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+of(Piece, int, int): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_game { label=<<B>game</B>>; style="rounded,dashed"; color="#3b6fd8"; fontsize=12;
IGame [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6"><FONT POINT-SIZE="9">«interface»</FONT><BR/><I><B>IGame</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+move(Position, Position): MoveResult<BR ALIGN="LEFT"/>+undo(): boolean<BR ALIGN="LEFT"/>+redo(): boolean<BR ALIGN="LEFT"/>+getTurn(): Color<BR ALIGN="LEFT"/>+getStatus(): GameStatus<BR ALIGN="LEFT"/>+isInCheck(Color): boolean<BR ALIGN="LEFT"/>+legalMoves(Position): Set&lt;Position&gt;<BR ALIGN="LEFT"/>+getBoard(): BoardView<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Game [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><B>Game</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-board: Board<BR ALIGN="LEFT"/>-validator: MoveValidator<BR ALIGN="LEFT"/>-checkDetector: CheckDetector<BR ALIGN="LEFT"/>-history: CommandHistory<BR ALIGN="LEFT"/>-turn: Color<BR ALIGN="LEFT"/>-status: GameStatus<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+move(...)<BR ALIGN="LEFT"/>+undo()<BR ALIGN="LEFT"/>+redo()<BR ALIGN="LEFT"/>+legalMoves(...)<BR ALIGN="LEFT"/>+isInCheck(...)<BR ALIGN="LEFT"/>-switchTurn()<BR ALIGN="LEFT"/>-updateStatus()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
GameStatus [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>GameStatus</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">IN_PROGRESS, CHECK,<BR ALIGN="LEFT"/>CHECKMATE, STALEMATE<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+isOver(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
MoveResult [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>MoveResult</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">SUCCESS, OUT_OF_BOARD,<BR ALIGN="LEFT"/>EMPTY_SQUARE, OPPONENT_PIECE,<BR ALIGN="LEFT"/>INVALID_PIECE_MOVE,<BR ALIGN="LEFT"/>LEAVES_KING_IN_CHECK, GAME_OVER<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getMessage(): String<BR ALIGN="LEFT"/>+isSuccess(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_commands { label=<<B>commands  (Command)</B>>; style="rounded,dashed"; color="#3b6fd8"; fontsize=12;
ICommand [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6"><FONT POINT-SIZE="9">«interface»</FONT><BR/><I><B>ICommand</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+execute()<BR ALIGN="LEFT"/>+undo()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
MoveCommand [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0fe"><B>MoveCommand</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-board: Board<BR ALIGN="LEFT"/>-from: Position<BR ALIGN="LEFT"/>-to: Position<BR ALIGN="LEFT"/>-capturedPiece: Piece<BR ALIGN="LEFT"/>-hadMovedBefore: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+execute()<BR ALIGN="LEFT"/>+undo()<BR ALIGN="LEFT"/>+getCapturedPiece(): Piece<BR ALIGN="LEFT"/>+getFrom(): Position<BR ALIGN="LEFT"/>+getTo(): Position<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
